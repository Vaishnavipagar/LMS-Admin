# LearnLoop Admin — environment variables (all optional)
#
# The admin panel works without Supabase. When the two VITE_SUPABASE_* values
# below are absent, the built-in demo sign-in is used. Connect Supabase for
# real authentication before using this deployment with sensitive data.

# --- Optional: Supabase auth (takes over when both values are set) ---
# Never commit real keys. Never use the service_role key in frontend code.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Optional: override the built-in demo admin credentials ---
# Vite inlines these into the client bundle, so they are NOT secret.
# VITE_ADMIN_EMAIL=admin@learnloop.io
# VITE_ADMIN_PASSWORD=admin123

# --- Optional: secure backend endpoint that accepts authenticated settings updates ---
# The browser never sends the service_role key — that stays in the server environment.
# VITE_ADMIN_SETTINGS_ENDPOINT=/api/admin/settings
